{
  "manifest_version": 3,
  "name": "hea-indir • Videoyu yakala",
  "version": "0.3.0",
  "description": "Algılanan videoları bilgisayarındaki hea-indir uygulamasına gönder.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "webRequest",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "hea-indir"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}